#!/bin/bash
# Renders UI states to PNGs without touching the screen or the real profile:
#   tools/shots <outdir> [scenario ...]     (no scenario: all of them; the list is in qml/Shots.qml)
# Builds build-dev first if needed (-j2, nice; BROWSER_BUILD=build for the release build). The app runs
# offscreen on a throwaway data dir.
set -eu
[ $# -ge 1 ] || { echo "usage: tools/shots <outdir> [scenario ...]" >&2; exit 2; }
root=$(dirname "$(dirname "$(readlink -f "$0")")")
out=$1; shift
# build-dev keeps the QML as source (BROWSER_DEV in CMakeLists.txt), so a QML edit rebuilds in about a second
dir=${BROWSER_BUILD:-build-dev}
dev=OFF; [ "$dir" = build-dev ] && dev=ON
cmake -S "$root" -B "$root/$dir" -G Ninja -DCMAKE_BUILD_TYPE=Release -DBROWSER_DEV=$dev >/dev/null
if ! log=$(nice cmake --build "$root/$dir" -j2 2>&1); then
    printf '%s\n' "$log" >&2
    exit 1
fi
# Chromium's GPU probe lines are noise here: shot mode creates no web views.
set -o pipefail
QT_FORCE_STDERR_LOGGING=1 "$root/$dir/browser" --shots "$out" "$@" 2>&1 \
    | { grep -vE 'default value of option force_gl_vendor|Vulkan|GPU vendor|GPUInfo|Icon theme' || true; }
