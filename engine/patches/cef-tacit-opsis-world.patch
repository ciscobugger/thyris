+void CefBrowserInfo::SetExtraInfo(CefRefPtr<CefDictionaryValue> extra_info) {
+  CefRefPtr<CefDictionaryValue> copy =
+      extra_info->Copy(/*exclude_empty_children=*/false);
+  static_cast<CefDictionaryValueImpl*>(copy.get())->MarkReadOnly();
+  base::AutoLock lock_scope(extra_info_lock_);
+  extra_info_ = copy;
+}
