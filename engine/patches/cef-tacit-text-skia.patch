 /**
  * Expands fDeviceGamma, fContrast, and fLumBits into a mask pre-blend.
  */
+// Tacit (2026-10-02): TACIT_TEXT_GAMMA and TACIT_TEXT_CONTRAST in the environment replace the text gamma and
+// contrast every glyph mask is blended with. Linux Chromium builds them in as 1.2 and 0.2, which draw light text on a
+// dark page thin and soft beside text blended for the screen; read once per process, so the values can be tuned at
+// start without a rebuild. Unset, empty or out of range: the surface's own value. Gamma 0 is the sRGB curve.
+static SkScalar TacitTextValue(const char* name, SkScalar fallback, SkScalar lo, SkScalar hi, bool hiInclusive) {
+    static const char* const kNames[2] = {"TACIT_TEXT_GAMMA", "TACIT_TEXT_CONTRAST"};
+    static const float kRead[2] = {
+        [] { const char* v = getenv(kNames[0]); return v && *v ? strtof(v, nullptr) : -1.f; }(),
